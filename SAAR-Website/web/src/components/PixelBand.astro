    <div>
      <p class="eyebrow">From pile to proof</p>
      <h2 id="band-title" class="h2">A trail from document to decision.</h2>
    </div>
    <ul class="band__legend">
      <li>Documents in</li>
      <li>Evidence read</li>
      <li>Ledger resolved</li>
    </ul>
  </div>
