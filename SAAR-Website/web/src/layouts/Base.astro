---
import "@fontsource/dotgothic16";
import "@fontsource/tiny5";
import "@fontsource-variable/hanken-grotesk";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import "../styles/home.css";
import "../styles/pages.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  tone?: "dark" | "light";
  noindex?: boolean;
}

const { title, description, tone = "light", noindex = false } = Astro.props;
const full = title === "SAAR" ? "SAAR: offline financial workspace, kept on your computer" : `${title} · SAAR`;
const origin = (Astro.site ?? new URL("https://saar.theshriks.space")).origin;
const canonical = new URL(Astro.url.pathname, origin).href;
const image = new URL("/og-image.png", origin).href;
const segs = Astro.url.pathname.split("/").filter(Boolean);
const graph: Record<string, unknown>[] = [
  { "@type": "Organization", "@id": `${origin}/#organization`, name: "THE SHRIKS", url: "https://github.com/THE-SHRIKS", sameAs: ["https://github.com/THE-SHRIKS"] },
  { "@type": "WebSite", "@id": `${origin}/#website`, url: `${origin}/`, name: "SAAR", inLanguage: "en", publisher: { "@id": `${origin}/#organization` } },
  {
    "@type": "SoftwareApplication",
    "@id": `${origin}/#software`,
    name: "SAAR",
    url: `${origin}/`,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Windows",
    description: "SAAR is an offline desktop workspace for financial documents, exact calculations, reconciliation and local AI. Open source and in development.",
    codeRepository: "https://github.com/THE-SHRIKS/SAAR-LokiXPiyush",
    isAccessibleForFree: true,
    publisher: { "@id": `${origin}/#organization` },
  },
  { "@type": "WebPage", "@id": `${canonical}#page`, url: canonical, name: full, description, inLanguage: "en", isPartOf: { "@id": `${origin}/#website` }, primaryImageOfPage: image },
];
if (segs.length) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "SAAR", item: `${origin}/` },
      { "@type": "ListItem", position: 2, name: title, item: canonical },
    ],
  });
}
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#004ac7" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="author" content="THE SHRIKS" />
    <meta property="og:site_name" content="SAAR" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SAAR: offline financial desk. Your data stays local." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader tone={tone} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "../scripts/motion.ts";
      import "../scripts/seams.ts";
    </script>
  </body>
</html>
